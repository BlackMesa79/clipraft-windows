{
  "name": "clipraft-windows",
  "version": "0.8.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "node scripts/tauri.mjs",
    "lint": "eslint src scripts vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css}\" \"scripts/**/*.{mjs,js,ts}\" vite.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\" \"scripts/**/*.{mjs,js,ts}\" vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7",
    "vue-tsc": "^3"
  }
}
